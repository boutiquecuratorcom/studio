{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's public profile information.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user's unique ID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the user profile was created."
        },
        "inventoryCountThisMonth": {
          "type": "number",
          "description": "The number of inventory items the user has created in the current month."
        },
        "inventoryMonthKey": {
          "type": "string",
          "description": "The year-month key (e.g., '2024-08') for tracking monthly inventory limits."
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "UserUpload": {
      "title": "User Upload",
      "description": "Represents a file uploaded by a user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "storagePath": { "type": "string" },
        "downloadURL": { "type": "string", "format": "uri" },
        "originalName": { "type": "string" },
        "contentType": { "type": "string" },
        "size": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isEnhanced": {
          "type": "boolean",
          "description": "Indicates if the image was generated by AI."
        }
      },
      "required": [
        "uid",
        "email",
        "storagePath",
        "downloadURL",
        "originalName",
        "contentType",
        "createdAt"
      ]
    },
    "BrandProfile": {
      "title": "Brand Profile",
      "description": "Represents a user's brand identity, voice, and visual settings.",
      "type": "object",
      "properties": {
        "brandName": { "type": "string", "description": "The user's brand name." },
        "tagline": { "type": "string", "description": "The brand's tagline." },
        "location": { "type": "string", "description": "City/State of the brand." },
        "websiteUrl": { "type": "string", "format": "uri", "description": "The brand's website URL." },
        "instagramUrl": { "type": "string", "format": "uri", "description": "The brand's Instagram URL." },
        "facebookUrl": { "type": "string", "format": "uri", "description": "The brand's Facebook page URL." },
        "toneOfVoice": { "type": "string", "enum": ["Warm & Friendly", "Witty", "Southern", "High-Fashion", "Minimal", "Bold", "Playful"] },
        "brandVibe": { "type": "string", "enum": ["Cozy Boutique", "Modern Minimal", "Luxury Editorial", "Trendy Pop"] },
        "targetCustomer": { "type": "string", "enum": ["Moms", "Young Professionals", "Size-Inclusive Shoppers", "Athleisure Lovers", "Modest Fashion", "Mixed"] },
        "primaryGoal": { "type": "string", "enum": ["Sell Faster", "Increase Engagement", "Look More Premium", "Build Community"] },
        "logoUrl": { "type": "string", "format": "uri", "description": "URL to the uploaded brand logo." },
        "brandColors": { "type": "array", "items": { "type": "string" }, "description": "Up to 3 brand colors in hex format." },
        "primaryFont": { "type": "string", "description": "The brand's primary font for headings." },
        "secondaryFont": { "type": "string", "description": "The brand's secondary font for body text." },
        "primaryPlatform": { "type": "string", "enum": ["Facebook", "Instagram", "Both"] },
        "postingFrequency": { "type": "string", "enum": ["Daily", "3x/week", "Weekly"] },
        "promoStyle": { "type": "string", "enum": ["Flash Sales", "Lives", "Outfit Drops", "Mystery Bundles"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "Represents a single item in the user's inventory.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string"
        },
        "brand": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "sizes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "image": {
          "type": "object",
          "properties": {
            "originalPath": {
              "type": "string"
            },
            "originalUrl": {
              "type": "string",
              "format": "uri"
            },
            "thumbPath": {
              "type": "string"
            },
            "thumbUrl": {
              "type": "string",
              "format": "uri"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          }
        },
        "analysis": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "complete",
                "failed"
              ]
            },
            "colors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "pattern": {
              "type": "string"
            },
            "categoryGuess": {
              "type": "string"
            },
            "tags": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "confidence": {
              "type": "number"
            },
            "error": {
              "type": "string"
            }
          }
        }
      },
      "required": [
        "ownerId",
        "brand",
        "title",
        "type",
        "sizes",
        "createdAt",
        "updatedAt",
        "image"
      ]
    }
  },
  "auth": {
    "providers": [
      "google.com",
      "password"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores user profile data, keyed by user ID."
    },
    "/users/{userId}/uploads/{uploadId}": {
      "schema": {
        "$ref": "#/entities/UserUpload"
      },
      "description": "Stores metadata for files uploaded by a user."
    },
    "/users/{userId}/brandProfile/{brandProfileId}": {
      "schema": {
        "$ref": "#/entities/BrandProfile"
      },
      "description": "Stores the user's brand profile. Expect a single document per user."
    },
    "/inventory/{itemId}": {
      "schema": {
        "$ref": "#/entities/InventoryItem"
      },
      "description": "Stores all user inventory items in a single collection."
    }
  }
}
