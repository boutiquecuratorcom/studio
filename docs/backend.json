{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "Represents a user's public profile information.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The user's unique ID."
        },
        "email": {
          "type": "string",
          "format": "email",
          "description": "The user's email address."
        },
        "displayName": {
          "type": "string",
          "description": "The user's display name."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "The timestamp when the user profile was created."
        },
        "inventoryCountThisMonth": {
          "type": "number",
          "description": "The number of inventory items the user has created in the current month."
        },
        "inventoryMonthKey": {
          "type": "string",
          "description": "The year-month key (e.g., '2024-08') for tracking monthly inventory limits."
        },
        "handle": {
          "type": "string",
          "description": "The user's unique, public boutique handle."
        }
      },
      "required": ["uid", "email", "createdAt"]
    },
    "UserUpload": {
      "title": "User Upload",
      "description": "Represents a file uploaded by a user.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "storagePath": { "type": "string" },
        "downloadURL": { "type": "string", "format": "uri" },
        "originalName": { "type": "string" },
        "contentType": { "type": "string" },
        "size": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "isEnhanced": {
          "type": "boolean",
          "description": "Indicates if the image was generated by AI."
        }
      },
      "required": [
        "uid",
        "email",
        "storagePath",
        "downloadURL",
        "originalName",
        "contentType",
        "createdAt"
      ]
    },
    "BrandProfile": {
      "title": "Brand Profile",
      "description": "Represents a user's brand identity, voice, and visual settings.",
      "type": "object",
      "properties": {
        "brandName": { "type": "string", "description": "The user's brand name." },
        "tagline": { "type": "string", "description": "The brand's tagline." },
        "location": { "type": "string", "description": "City/State of the brand." },
        "websiteUrl": { "type": "string", "format": "uri", "description": "The brand's website URL." },
        "instagramUrl": { "type": "string", "format": "uri", "description": "The brand's Instagram URL." },
        "facebookUrl": { "type": "string", "format": "uri", "description": "The brand's Facebook page URL." },
        "toneOfVoice": { "type": "string", "enum": ["Warm & Friendly", "Witty", "Southern", "High-Fashion", "Minimal", "Bold", "Playful"] },
        "brandVibe": { "type": "string", "enum": ["Cozy Boutique", "Modern Minimal", "Luxury Editorial", "Trendy Pop"] },
        "targetCustomer": { "type": "string", "enum": ["Moms", "Young Professionals", "Size-Inclusive Shoppers", "Athleisure Lovers", "Modest Fashion", "Mixed"] },
        "primaryGoal": { "type": "string", "enum": ["Sell Faster", "Increase Engagement", "Look More Premium", "Build Community"] },
        "logoUrl": { "type": "string", "format": "uri", "description": "URL to the uploaded brand logo." },
        "brandColors": { "type": "array", "items": { "type": "string" }, "description": "Up to 3 brand colors in hex format." },
        "primaryFont": { "type": "string", "description": "The brand's primary font for headings." },
        "secondaryFont": { "type": "string", "description": "The brand's secondary font for body text." },
        "primaryPlatform": { "type": "string", "enum": ["Facebook", "Instagram", "Both"] },
        "postingFrequency": { "type": "string", "enum": ["Daily", "3x/week", "Weekly"] },
        "promoStyle": { "type": "string", "enum": ["Flash Sales", "Lives", "Outfit Drops", "Mystery Bundles"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "BoutiqueSettings": {
      "title": "Boutique Settings",
      "description": "Settings for a user's public-facing boutique page.",
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "description": "Whether the boutique page is live and public."
        },
        "featuredOutfitId": {
          "type": ["string", "null"],
          "description": "The ID of the outfit to feature. Null means show the latest."
        },
        "accentColor": {
          "type": ["string", "null"],
          "description": "A custom accent color for the boutique page. Defaults to the brand's primary color."
        },
        "stylePreset": {
          "type": "string",
          "enum": ["magazine", "modern", "classic"],
          "description": "The visual layout preset for the boutique page."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "HandleMapping": {
      "title": "Handle-to-UID Mapping",
      "description": "Maps a unique, public handle to a Firebase Auth UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "The Firebase Auth UID of the boutique owner."
        },
        "handle": {
          "type": "string",
          "description": "The public, URL-friendly handle for the boutique."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "handle", "createdAt", "updatedAt"]
    },
    "PublicBoutiqueProfile": {
      "title": "Public Boutique Profile",
      "description": "Denormalized public data for a boutique showcase, keyed by handle.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string"
        },
        "handle": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "brandName": {
          "type": [
            "string",
            "null"
          ]
        },
        "tagline": {
          "type": [
            "string",
            "null"
          ]
        },
        "logoUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "accentColor": {
          "type": [
            "string",
            "null"
          ]
        },
        "featuredOutfit": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "id": {
              "type": "string"
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "imageUrl": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            },
            "description": {
              "type": [
                "string",
                "null"
              ]
            },
            "itemCount": {
              "type": [
                "number",
                "null"
              ]
            },
             "outfitClaim": {
              "type": [
                "object",
                "null"
              ]
            }
          }
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "InventoryItem": {
      "title": "Inventory Item",
      "description": "Represents a single item in the user's inventory.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string"
        },
        "brand": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "type": {
          "type": "string"
        },
        "sizes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "image": {
          "type": "object",
          "description": "The display image for the item. Can be the original photo or a Glow-Up.",
          "properties": {
            "originalPath": {
              "type": "string"
            },
            "originalUrl": {
              "type": "string",
              "format": "uri"
            },
            "thumbPath": {
              "type": "string"
            },
            "thumbUrl": {
              "type": "string",
              "format": "uri"
            },
            "width": {
              "type": "number"
            },
            "height": {
              "type": "number"
            }
          }
        },
        "originalImageDetails": {
            "type": "object",
            "description": "Stores the details of the original product photo, used for analysis.",
            "properties": {
                "originalPath": { "type": "string" },
                "originalUrl": { "type": "string", "format": "uri" },
                "thumbPath": { "type": "string" },
                "thumbUrl": { "type": "string", "format": "uri" }
            }
        },
        "glowUpId": {
            "type": "string",
            "description": "The ID of the GlowUp record associated with this item."
        },
        "glowedAt": {
            "type": "string",
            "format": "date-time",
            "description": "The timestamp when the item was last 'glowed up'."
        },
        "searchKeywords": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "A denormalized array of lowercase keywords for search."
        },
        "analysis": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "pending",
                "complete",
                "failed"
              ]
            },
            "dominantColors": {
              "type": "array",
              "items": { "type": "string" },
              "description": "3-6 dominant colors from the image as hex codes."
            },
            "patternType": {
              "type": "string",
              "description": "e.g., floral, geometric, stripe, solid, abstract"
            },
            "patternDescription": {
              "type": "string",
              "description": "A human-readable description of the pattern."
            },
            "styleVibe": {
              "type": "string",
              "description": "e.g., bold, soft, elegant, casual"
            },
            "clothingType": {
              "type": "string",
              "description": "AI's best guess of the clothing type (dress, top, etc.)."
            },
            "visualDescription": {
              "type": "string",
              "description": "A 1-2 sentence descriptive summary of the item's appearance."
            },
            "tags": {
              "type": "array",
              "items": { "type": "string" },
              "description": "8-15 relevant keywords for search and filtering."
            },
            "facebookCaptionHooks": {
              "type": "array",
              "items": { "type": "string" },
              "description": "3 short, engaging hooks for Facebook captions."
            },
            "instagramCaptionHooks": {
              "type": "array",
              "items": { "type": "string" },
              "description": "3 short, trendy, emoji-heavy hooks for Instagram captions."
            },
            "error": {
              "type": "string",
              "description": "Stores an error message if the analysis failed."
            }
          }
        },
        "claim": {
          "type": "object",
          "description": "Defines the call-to-action or claim method for this specific item.",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "none",
                "custom_url",
                "messenger",
                "facebook_page",
                "whatsapp",
                "sonlet_manual"
              ]
            },
            "url": {
              "type": [
                "string",
                "null"
              ],
              "format": "uri"
            },
            "label": {
              "type": [
                "string",
                "null"
              ]
            },
            "updatedAt": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        }
      },
      "required": [
        "ownerId",
        "brand",
        "title",
        "type",
        "sizes",
        "createdAt",
        "updatedAt",
        "image"
      ]
    },
    "Post": {
      "title": "Post Draft",
      "description": "A saved draft of a social media post created in the Post Creator.",
      "type": "object",
      "properties": {
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "platformFormat": {
          "type": "string",
          "enum": [
            "IG_FEED",
            "FB_FEED"
          ]
        },
        "templateId": {
          "type": "string",
          "enum": [
            "CLEAN_BOUTIQUE",
            "BOLD_DROP",
            "MINIMAL_LUXE",
            "COMMENT_SOLD_LIVE"
          ]
        },
        "frameStyle": {
          "type": "string",
          "enum": [
            "none",
            "classicBorder",
            "polaroid",
            "shadowCard",
            "accentStroke"
          ],
          "description": "The decorative frame style for the post."
        },
        "enhancedImageUrl": {
          "type": "string",
          "format": "uri"
        },
        "textFields": {
          "type": "object",
          "properties": {
            "headline": {
              "type": "string"
            },
            "subtext": {
              "type": "string"
            },
            "cta": {
              "type": "string"
            }
          }
        },
        "styleConfig": {
            "type": "object",
            "properties": {
                "headline": { "$ref": "#/entities/StyleOptions" },
                "subtext": { "$ref": "#/entities/StyleOptions" },
                "cta": { "$ref": "#/entities/StyleOptions" }
            }
        },
        "brandSnapshot": {
          "type": "object",
          "properties": {
            "primaryFont": {
              "type": "string"
            },
            "secondaryFont": {
              "type": "string"
            },
            "brandColors": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      },
      "required": [
        "createdAt",
        "platformFormat",
        "templateId",
        "enhancedImageUrl",
        "textFields"
      ]
    },
    "StyleOptions": {
      "title": "Text Style Options",
      "description": "Styling options for a text layer on a post.",
      "type": "object",
      "properties": {
        "textColorMode": {
          "type": "string",
          "enum": ["auto", "light", "dark", "brandPrimary", "brandAccent"]
        },
        "badgeColor": {
          "type": "string",
          "description": "The hex color code for the background badge, or 'none' if disabled."
        },
        "position": {
          "type": "string",
          "enum": ["top", "center", "bottom"]
        }
      }
    },
    "EngagementIdea": {
      "title": "Engagement Idea",
      "description": "A single AI-generated engagement idea.",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "The short, catchy title for the idea." },
        "caption": { "type": "string", "description": "The ready-to-post caption text." },
        "whyItWorks": { "type": "string", "description": "A brief explanation of the strategy behind the idea." },
        "ctaSuggestion": { "type": "string", "description": "A suggested call-to-action to include." },
        "recommendedFormat": { "type": "string", "description": "The suggested post format (e.g., 'Reel', 'Carousel', 'Static Post')." }
      },
      "required": ["title", "caption", "whyItWorks", "ctaSuggestion"]
    },
    "EngagementDrop": {
      "title": "Daily Engagement Drop",
      "description": "Stores a user's daily set of 5 generated engagement ideas and the settings used.",
      "type": "object",
      "properties": {
        "createdAt": { "type": "string", "format": "date-time" },
        "intensity": { "type": "string", "enum": ["Safe", "Bold", "Viral"] },
        "goal": { "type": "string", "enum": ["Engagement", "Sales", "Both"] },
        "platform": { "type": "string", "enum": ["Facebook", "Instagram", "Both"] },
        "ideas": {
          "type": "array",
          "items": { "$ref": "#/entities/EngagementIdea" },
          "minItems": 5,
          "maxItems": 5
        }
      },
      "required": ["createdAt", "intensity", "goal", "platform", "ideas"]
    },
    "GlowUp": {
      "title": "Glow-Up Record",
      "description": "Represents a record of an AI image enhancement.",
      "type": "object",
      "properties": {
        "sourceType": {
          "type": "string",
          "enum": ["rackItem", "upload"],
          "description": "The source of the image, either from 'My Rack' or a direct 'upload'."
        },
        "sourceId": {
          "type": "string",
          "description": "The ID of the source document (e.g., rackItemId or uploadId)."
        },
        "linkedRackItemId": {
            "type": ["string", "null"],
            "description": "If this GlowUp has been assigned to a rack item, this is its ID."
        },
        "inputImageUrl": {
          "type": "string",
          "format": "uri"
        },
        "inputImageStoragePath": {
          "type": "string",
          "description": "The Firebase Storage path for the input image."
        },
        "outputImageUrl": {
          "type": "string",
          "format": "uri"
        },
        "outputThumbUrl": {
          "type": "string",
          "format": "uri"
        },
        "storagePath": {
          "type": "string"
        },
        "thumbStoragePath": {
          "type": "string"
        },
        "stylePreset": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["processing", "completed", "failed"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["sourceType", "sourceId", "inputImageUrl", "createdAt", "status"]
    },
    "Outfit": {
      "title": "Outfit",
      "description": "Represents a collection of rack items, potentially with a cover image.",
      "type": "object",
      "properties": {
        "ownerId": { "type": "string" },
        "title": { "type": "string" },
        "internalNotes": { "type": "string" },
        "storefrontDescription": { "type": "string" },
        "socialCaption": { "type": "string" },
        "descriptionLastGeneratedAt": { "type": "string", "format": "date-time" },
        "outfitClaim": {
          "type": "object",
          "properties": {
            "mode": { "type": "string", "enum": ["individual", "outfit"] },
            "claim": {
              "type": "object",
              "properties": {
                "mode": { "type": "string", "enum": ["none", "custom_url", "messenger", "facebook_page", "whatsapp", "sonlet_manual"] },
                "url": { "type": ["string", "null"], "format": "uri" },
                "label": { "type": ["string", "null"] },
                "updatedAt": { "type": ["string", "null"], "format": "date-time" }
              }
            }
          }
        },
        "linkedRackItemIds": {
          "type": "array",
          "items": { "type": "string" }
        },
        "cover": {
          "type": "object",
          "properties": {
            "imageUrl": { "type": ["string", "null"] },
            "thumbUrl": { "type": ["string", "null"] },
            "storagePath": { "type": ["string", "null"] },
            "thumbStoragePath": { "type": ["string", "null"] },
            "source": { "type": "string", "enum": ["ai", "manual"] },
            "glowUpId": { "type": ["string", "null"] },
            "generatedAt": { "type": ["string", "null"], "format": "date-time" },
            "status": { "type": "string", "enum": ["idle", "generating", "completed", "error"] },
            "error": { "type": ["string", "null"] },
            "prefs": {
              "type": "object",
              "properties": {
                "preset": { "type": "string" },
                "accessories": { "type": "string" },
                "layout": { "type": "string" }
              }
            }
          }
        },
        "status": { "type": "string", "enum": ["draft", "published"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["ownerId", "title", "createdAt", "updatedAt"]
    }
  },
  "auth": {
    "providers": [
      "google.com",
      "password"
    ]
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "Stores user profile data, keyed by user ID."
    },
    "/users/{userId}/uploads/{uploadId}": {
      "schema": {
        "$ref": "#/entities/UserUpload"
      },
      "description": "Stores metadata for files uploaded by a user."
    },
    "/users/{userId}/brandProfile/{brandProfileId}": {
      "schema": {
        "$ref": "#/entities/BrandProfile"
      },
      "description": "Stores the user's brand profile. Expect a single document per user."
    },
    "/users/{userId}/boutiqueSettings/{settingsId}": {
      "schema": {
        "$ref": "#/entities/BoutiqueSettings"
      },
      "description": "Stores the user's public boutique settings. Expect a single document named 'main'."
    },
    "/users/{userId}/posts/{postId}": {
      "schema": {
        "$ref": "#/entities/Post"
      },
      "description": "Stores saved post drafts for a user."
    },
     "/handles/{handle}": {
      "schema": {
        "$ref": "#/entities/HandleMapping"
      },
      "description": "Maps unique public handles to owner UIDs to enable pretty URLs."
    },
    "/publicBoutiques/{handle}": {
      "schema": {
        "$ref": "#/entities/PublicBoutiqueProfile"
      },
      "description": "Stores the denormalized, public-facing data for a boutique, keyed by handle."
    },
    "/inventory/{itemId}": {
      "schema": {
        "$ref": "#/entities/InventoryItem"
      },
      "description": "Stores all user inventory items in a single collection."
    },
    "/users/{userId}/engagementDrops/{dropId}": {
      "schema": {
        "$ref": "#/entities/EngagementDrop"
      },
      "description": "Stores a user's daily generated engagement ideas. The {dropId} should be in YYYY-MM-DD format."
    },
    "/users/{userId}/glowUps/{glowUpId}": {
      "schema": {
        "$ref": "#/entities/GlowUp"
      },
      "description": "Stores a record of each AI image enhancement."
    },
    "/outfits/{outfitId}": {
      "schema": {
        "$ref": "#/entities/Outfit"
      },
      "description": "Stores user-created outfits."
    }
  }
}
