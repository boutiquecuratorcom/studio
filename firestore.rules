rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check ownership
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Allow users to read and write their own user-specific documents
    match /users/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }
    
    // Rules for the root 'inventory' collection
    match /inventory/{itemId} {
      // Allow a user to get a single document if they are its owner.
      // This is for the item detail page. `resource.data` is available for `get`.
      allow get: if isOwner(resource.data.ownerId);

      // Allow a user to list documents. The client query MUST filter by ownerId
      // for this to be secure, which our app does.
      allow list: if request.auth != null;
      
      // Allow users to create an item if the new item's ownerId is their own.
      allow create: if isOwner(request.resource.data.ownerId);
      
      // Allow users to update or delete an item if they are the owner of the existing item.
      allow update, delete: if isOwner(resource.data.ownerId);
    }

    // Rules for the 'outfits' collection
    match /outfits/{outfitId} {
      // Allow get/update/delete if the user is the owner
      allow get, update, delete: if isOwner(resource.data.ownerId);

      // Allow a user to list their own outfits (client query must filter by ownerId)
      allow list: if request.auth != null;
      
      // Allow a user to create an outfit if the ownerId matches their own
      allow create: if isOwner(request.resource.data.ownerId);
    }

    // Rules for the 'handles' collection (replaces old publicBoutiques)
    match /handles/{handle} {
      // Authenticated users can read to check for availability
      allow read: if request.auth != null;
      
      // An authenticated user can create a handle for themselves, but only
      // if one for that handle doesn't already exist.
      allow create: if isOwner(request.resource.data.uid) && !exists(/databases/$(database)/documents/handles/$(handle));

      // Only the owner can update or delete their handle mapping.
      allow update, delete: if isOwner(resource.data.uid);
    }
    
    // Rules for the denormalized 'publicBoutiques' collection
    match /publicBoutiques/{handle} {
      // Allow public read ONLY if the boutique is enabled.
      allow read: if resource.data.enabled == true;

      // Only the owner can create or update their public profile
      allow create: if request.resource.data.uid == request.auth.uid;
      allow update: if request.auth.uid == resource.data.uid;
      
      // Allow owner to delete (for handle migrations)
      allow delete: if isOwner(resource.data.uid);
    }
  }
}
