rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // WARNING: This is a temporary rule for debugging purposes only.
    // It allows any user to read or write to any part of your database.
    // This will be removed once the connection test is complete.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
